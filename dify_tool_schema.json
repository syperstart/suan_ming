{
  "openapi": "3.1.0",
  "info": {
    "title": "算命后端",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://host.docker.internal:8000"
    }
  ],
  "paths": {
    "/chat": {
      "post": {
        "summary": "和陈大师对话（会先判断用户情绪，再用对应语气回答）",
        "operationId": "chat",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "用户说的话，例如：帮我算算今天的运势",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "返回陈大师的回答"
          }
        }
      }
    },
    "/qingxu": {
      "post": {
        "summary": "判断用户情绪，返回一个英文标签（angry/cheerful/depressed/friendly/upbeat/default）",
        "operationId": "qingxu",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "用户说的话",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "返回情绪标签"
          }
        }
      }
    }
  }
}
