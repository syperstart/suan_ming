# ============================================================
#  .gitignore —— 告诉 git "这些文件不要上传"
#
#  ★ 密钥只放在 .env 里（已被排除），其它文件都可以安全上传。
#    config.py 现在不含密钥（改成从环境变量/.env 读），所以允许上传。
#
#  约定：下划线（_）开头的文件 = 临时文件，用完就删，也不上传。
# ============================================================

# ---------- 绝对不能上传：密钥和隐私 ----------
.env
.env.*
# ★ 但模板要上传（里面只有占位符，没有真密钥）—— 注意：.gitignore 不支持行尾注释！
!.env.example

# ---------- 聊天记录（含用户隐私）----------
memory.json
memory_*.json

# ---------- 运行时数据（★ 含 90MB 嵌入模型缓存，绝不能上传）----------
data/
local_qdrant/

# ---------- 缓存（会自动重建）----------
__pycache__/
*.pyc
.venv/
venv/

# ---------- 编辑器 / 工具目录 ----------
.idea/
.vscode/
.workbuddy/

# ---------- 临时文件（下划线开头的都不上传）----------
_*.py
_*.txt
_*.js
_*.log
