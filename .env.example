# ============================================================
#  .env.example —— 环境变量模板（这个文件可以上传到 git）
#
#  用法：
#    1. 把本文件复制一份，改名为 .env
#    2. 把下面的值换成你自己的真实密钥
#    3. .env 已被 .gitignore 排除，不会上传——密钥是安全的
#
#  docker compose 会自动读取同目录的 .env 文件来填 docker-compose.yml 里的 ${变量}
# ============================================================

# 大模型密钥（DeepSeek：https://platform.deepseek.com → API Keys）
API_KEY=在这里填你的密钥

# 模型和接口地址（不改就用默认值）
MODEL_NAME=deepseek-v4-flash-vision-exp
BASE_URL=https://api.deepseek.com

# 博查搜索密钥（联网搜索用；没申请就留空）
# https://open.bochaai.com 微信扫码登录 → API Key 管理 → 创建密钥
BOCHA_API_KEY=
